{
  "name": "agenfy",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @agenfy/web dev",
    "dev:web": "pnpm --filter @agenfy/web dev",
    "dev:console": "pnpm --filter @agenfy/console dev",
    "dev:app": "pnpm --filter @agenfy/app dev",
    "build": "pnpm -r --parallel build",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "linkifyjs": "4.3.3",
      "prosemirror-changeset": "2.4.4",
      "prosemirror-schema-list": "1.5.1",
      "prosemirror-transform": "1.12.2",
      "prosemirror-view": "1.42.6"
    }
  }
}
