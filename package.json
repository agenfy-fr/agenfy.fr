{
  "name": "agenfy",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @agenfy/web dev",
    "dev:web": "pnpm --filter @agenfy/web dev",
    "dev:console": "pnpm --filter @agenfy/console dev",
    "dev:app": "pnpm --filter @agenfy/app dev",
    "build": "pnpm -r --parallel build",
    "lint": "pnpm -r lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  }
}
