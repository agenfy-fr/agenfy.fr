# app.agenfy.fr — copy to .env.local (never commit real values)

# Supabase project shared by www / console / app
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Optional: lets staff invite learners who have no account yet.
# NEVER expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app (magic-link and invitation redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3002
