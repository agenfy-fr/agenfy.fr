# apps/console — copy to .env.local (never commit real values).
# `next build` works without any of these; the app needs them at runtime.

# Same Supabase project as apps/web and apps/app (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted instead of the anon key.)

# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for: invitations
# (auth.admin.inviteUserByEmail), personal API tokens and the MCP server.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used in e-mail links (magic link, invitations) and MCP URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Origin of the training platform (apps/app): redirect of training invitations
# sent from the console (client → Accès) and link shown to learner-only
# accounts. Defaults to https://app.agenfy.fr (http://localhost:3002 in dev).
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Optional: comma-separated proxy IPs to trust in X-Forwarded-For (rate limiting).
TRUSTED_PROXY_IPS=

# Legal mentions printed on quotes / invoices. Unset values are not printed:
# fill them with the real Hasfy SAS identifiers before issuing invoices.
BILLING_LEGAL_NAME=Hasfy SAS
BILLING_ADDRESS=
BILLING_SIREN=
BILLING_VAT_NUMBER=
BILLING_EMAIL=
BILLING_IBAN=
BILLING_PAYMENT_TERMS=

# Mailbox (Messagerie, owner/admin). Configure it in Paramètres → Messagerie:
# the password is encrypted (AES-256-GCM) with this key before being stored.
# Generate: openssl rand -base64 32. Changing it = re-enter the mailbox password.
MAIL_ENCRYPTION_KEY=
# Optional fallback when nothing is saved in Paramètres (OVH MX Plan values):
MAIL_ADDRESS=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_IMAP_HOST=ssl0.ovh.net
MAIL_IMAP_PORT=993
MAIL_SMTP_HOST=ssl0.ovh.net
MAIL_SMTP_PORT=465
MAIL_DISPLAY_NAME=Agenfy

# Blog (www.agenfy.fr/blog): optional immediate refresh of the public site after
# a publish. Same random value in the www Vercel project. Unset = ISR (5 min).
REVALIDATE_SECRET=
# Optional, default https://www.agenfy.fr (point to a preview deployment to test).
WEB_SITE_URL=
